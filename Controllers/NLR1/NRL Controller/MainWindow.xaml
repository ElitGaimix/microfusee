<Window x:Name="MainWindow1" x:Class="MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NLS_Controller"
        mc:Ignorable="d"
        Title="NLR Controller" Height="600" Width="1200
        "
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <!-- Status Connexion -->
        <Border Grid.Row="1" Grid.Column="0" Margin="5" Background="LightGray" BorderBrush="Gray" BorderThickness="2">
            <StackPanel>
                <TextBlock Text="Status" FontSize="18" FontWeight="Bold" Margin="5"/>
                <TextBlock Text="Sol :" FontWeight="Bold"/>
                <TextBlock x:Name="GroundStatus" Text="Déconnecté" Background="LightPink" Margin="5" Padding="4"/>
                <TextBlock Text="Fusée :" FontWeight="Bold"/>
                <TextBlock x:Name="AirStatus" Text="Déconnecté" Background="LightPink" Margin="5" Padding="4"/>
            </StackPanel>
        </Border>

        <!-- Titre -->
        <TextBlock Grid.Column="1" Grid.ColumnSpan="3" Grid.Row="0" 
                   Text="NLR Panel" FontSize="28" FontWeight="Bold" 
                   TextAlignment="Center" VerticalAlignment="Center" />

        <!-- IP -->

        <!-- LoRa -->
        <Border Grid.Row="1" Grid.Column="1" Margin="5" Background="LightPink" BorderBrush="Gray" BorderThickness="2">
            <StackPanel x:Name="LoRaStatusPanel">
                <TextBlock x:Name="LoRaStatus" Text="État LoRa: Déconnecté" Margin="5"/>
                <TextBlock x:Name="LoRaLastMessage" Text="Dernier message LoRa:" Margin="5"/>
            </StackPanel>
        </Border>

        <!-- GPS -->
        <Border Grid.Row="1" Grid.Column="2" Margin="5" Background="LightPink" BorderBrush="Gray" BorderThickness="2">
            <StackPanel x:Name="GPSStatusPanel">
                <TextBlock x:Name="Latitude" Text="Latitude: 0.0" Margin="3"/>
                <TextBlock x:Name="Longitude" Text="Longitude: 0.0" Margin="3"/>
                <TextBlock x:Name="GpsAlt" Text="Altitude: 0m" Margin="3"/>
                <TextBlock x:Name="Speed" Text="Vitesse: 0km/h" Margin="3"/>
                <TextBlock x:Name="Sat" Text="Satellites: 0" Margin="3"/>
            </StackPanel>
        </Border>

        <!-- Air/BMP280 -->
        <Border Grid.Row="1" Grid.Column="3" Margin="5" Background="LightPink" BorderBrush="Gray" BorderThickness="2">
            <StackPanel x:Name="AirStatusPanel">
                <TextBlock x:Name="AirStatusText" Text="État BMP280: Déconnecté" Margin="3"/>
                <TextBlock x:Name="Temp" Text="Température: 0°C" Margin="3"/>
                <TextBlock x:Name="Pres" Text="Pression: 0hPa" Margin="3"/>
                <TextBlock x:Name="PresAlt" Text="Altitude: 0m" Margin="3"/>
            </StackPanel>
        </Border>

        <!-- Rocket image + nom -->
        <Grid Grid.Row="1" Grid.RowSpan="3" Grid.Column="4" Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="43*"/>
                <RowDefinition Height="71*"/>
            </Grid.RowDefinitions>
            <Image Source="rocket.png" Stretch="Uniform" RenderTransformOrigin="0.5,0.5" Margin="-128,-40,-151,40" Grid.RowSpan="2">
                <Image.RenderTransform>
                    <RotateTransform Angle="90"/>
                </Image.RenderTransform>
            </Image>
            <Border Background="LightBlue" BorderBrush="Gray" BorderThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,10" Grid.Row="1"/>
        </Grid>

        <!-- Map -->
        <Border Grid.Row="2" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="4" Margin="5" BorderBrush="Gray" BorderThickness="2">
            <TextBlock Text="(Carte Google Maps intégrée ici)" HorizontalAlignment="Center" VerticalAlignment="Center" FontStyle="Italic" Foreground="Gray"/>
        </Border>
        <ComboBox x:Name="ComboBoxPorts" HorizontalAlignment="Left" Margin="52,38,0,0" VerticalAlignment="Top" Width="120"/>
        <Button x:Name="refresh" Content="⟲" HorizontalAlignment="Left" Margin="177,38,0,0" VerticalAlignment="Top" Height="22"/>
        <Label Content="Ports COM :" HorizontalAlignment="Left" VerticalAlignment="Top" Width="133" FontSize="20" Margin="58,0,0,0"/>
    </Grid>
</Window>