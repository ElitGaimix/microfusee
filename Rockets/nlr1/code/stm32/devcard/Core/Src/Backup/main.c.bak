
/* USER CODE BEGIN Header */
/*
 * Diagnostic liaison AirPort :
 * RP1 / ELRS -> USART6 DMA -> STM32F401
 * STM32F401 -> USART2 -> PC
 *
 * USART6 : reception DMA en mode normal + detection IDLE
 * USART2 : affichage des octets recus en hexadecimal
 */
/* USER CODE END Header */

#include "main.h"
#include "dma.h"
#include "usart.h"
#include "gpio.h"

#include <stdio.h>
#include <stdint.h>
#include <string.h>

/* USER CODE BEGIN PV */

#define UART6_RX_BUF_SIZE 128
#define RX_QUEUE_SIZE     8

static uint8_t uart6_rx_buf[UART6_RX_BUF_SIZE];

/* File de reception : chaque element contient un paquet recu */
static uint8_t rx_queue[RX_QUEUE_SIZE][UART6_RX_BUF_SIZE];
static uint16_t rx_queue_size[RX_QUEUE_SIZE];

static volatile uint8_t queue_head = 0;
static volatile uint8_t queue_tail = 0;
static volatile uint8_t queue_count = 0;

static volatile uint32_t rx_dropped = 0;
static volatile uint32_t rx_errors = 0;

extern DMA_HandleTypeDef hdma_usart6_rx;

/* USER CODE END PV */

/* USER CODE BEGIN PFP */

void SystemClock_Config(void);
void Error_Handler(void);
static HAL_StatusTypeDef UART6_StartReception(void);

/* USER CODE END PFP */

/* USER CODE BEGIN 0 */

/* Redirection de printf vers USART2 */
int _write(int file, char *ptr, int len)
{
    (void)file;

    if (len <= 0)
    {
        return 0;
    }

    if (HAL_UART_Transmit(&huart2,
                          (uint8_t *)ptr,
                          (uint16_t)len,
                          HAL_MAX_DELAY) != HAL_OK)
    {
        return -1;
    }

    return len;
}

/* Demarre ou relance la reception DMA USART6 */
static HAL_StatusTypeDef UART6_StartReception(void)
{
    HAL_StatusTypeDef status;

    status = HAL_UARTEx_ReceiveToIdle_DMA(
        &huart6,
        uart6_rx_buf,
        UART6_RX_BUF_SIZE
    );

    if (status == HAL_OK && huart6.hdmarx != NULL)
    {
        /* Le callback demi-transfert n'est pas utilise */
        __HAL_DMA_DISABLE_IT(huart6.hdmarx, DMA_IT_HT);
    }

    return status;
}

/* USER CODE END 0 */

int main(void)
{
    HAL_Init();

    SystemClock_Config();

    MX_GPIO_Init();
    MX_DMA_Init();
    MX_USART6_UART_Init();
    MX_USART2_UART_Init();

    printf("\r\n=== Diagnostic AirPort / USART6 ===\r\n");
    printf("USART6 : DMA normal + detection IDLE\r\n");
    printf("USART2 : affichage PC\r\n");
    printf("Buffer RX : %u octets\r\n", UART6_RX_BUF_SIZE);
    printf("File RX : %u paquets\r\n\r\n", RX_QUEUE_SIZE);

    if (UART6_StartReception() != HAL_OK)
    {
        printf("ERREUR : demarrage DMA impossible\r\n");
        Error_Handler();
    }

    while (1)
    {
        uint8_t local_buf[UART6_RX_BUF_SIZE];
        uint16_t local_size = 0;
        uint8_t has_data = 0;

        uint32_t local_dropped;
        uint32_t local_errors;

        /*
         * Recuperation d'un paquet depuis la file.
         * La section critique est courte.
         */
        __disable_irq();

        if (queue_count > 0)
        {
            local_size = rx_queue_size[queue_tail];

            memcpy(local_buf,
                   rx_queue[queue_tail],
                   local_size);

            queue_tail = (uint8_t)((queue_tail + 1)
                                   % RX_QUEUE_SIZE);

            queue_count--;
            has_data = 1;
        }

        local_dropped = rx_dropped;
        rx_dropped = 0;

        local_errors = rx_errors;
        rx_errors = 0;

        __enable_irq();

        if (has_data)
        {
            printf("USART6 RX (%u octets) :",
                   (unsigned int)local_size);

            for (uint16_t i = 0; i < local_size; i++)
            {
                printf(" %02X", local_buf[i]);
            }

            printf("\r\n");

            HAL_GPIO_TogglePin(LD2_GPIO_Port, LD2_Pin);
        }

        if (local_dropped > 0)
        {
            printf("ATTENTION : %lu paquet(s) perdu(s)"
                   " - file pleine\r\n",
                   (unsigned long)local_dropped);
        }

        if (local_errors > 0)
        {
            printf("ATTENTION : %lu erreur(s) de"
                   " reception ou de relance DMA\r\n",
                   (unsigned long)local_errors);
        }
    }
}

/* Configuration de l'horloge d'origine */
void SystemClock_Config(void)
{
    RCC_OscInitTypeDef RCC_OscInitStruct = {0};
    RCC_ClkInitTypeDef RCC_ClkInitStruct = {0};

    __HAL_RCC_PWR_CLK_ENABLE();

    __HAL_PWR_VOLTAGESCALING_CONFIG(
        PWR_REGULATOR_VOLTAGE_SCALE2
    );

    RCC_OscInitStruct.OscillatorType = RCC_OSCILLATORTYPE_HSI;
    RCC_OscInitStruct.HSIState = RCC_HSI_ON;
    RCC_OscInitStruct.HSICalibrationValue =
        RCC_HSICALIBRATION_DEFAULT;

    RCC_OscInitStruct.PLL.PLLState = RCC_PLL_ON;
    RCC_OscInitStruct.PLL.PLLSource = RCC_PLLSOURCE_HSI;
    RCC_OscInitStruct.PLL.PLLM = 16;
    RCC_OscInitStruct.PLL.PLLN = 336;
    RCC_OscInitStruct.PLL.PLLP = RCC_PLLP_DIV4;
    RCC_OscInitStruct.PLL.PLLQ = 7;

    if (HAL_RCC_OscConfig(&RCC_OscInitStruct) != HAL_OK)
    {
        Error_Handler();
    }

    RCC_ClkInitStruct.ClockType =
        RCC_CLOCKTYPE_HCLK |
        RCC_CLOCKTYPE_SYSCLK |
        RCC_CLOCKTYPE_PCLK1 |
        RCC_CLOCKTYPE_PCLK2;

    RCC_ClkInitStruct.SYSCLKSource = RCC_SYSCLKSOURCE_PLLCLK;
    RCC_ClkInitStruct.AHBCLKDivider = RCC_SYSCLK_DIV1;
    RCC_ClkInitStruct.APB1CLKDivider = RCC_HCLK_DIV2;
    RCC_ClkInitStruct.APB2CLKDivider = RCC_HCLK_DIV1;

    if (HAL_RCC_ClockConfig(&RCC_ClkInitStruct,
                            FLASH_LATENCY_2) != HAL_OK)
    {
        Error_Handler();
    }
}

/* Callback de reception DMA avec detection IDLE */
void HAL_UARTEx_RxEventCallback(UART_HandleTypeDef *huart,
                                uint16_t Size)
{
    if (huart->Instance != USART6)
    {
        return;
    }

    if (Size > UART6_RX_BUF_SIZE)
    {
        Size = UART6_RX_BUF_SIZE;
    }

    /*
     * Copier le paquet dans la file avant de relancer le DMA.
     * Aucun printf dans le callback.
     */
    if (Size > 0)
    {
        if (queue_count < RX_QUEUE_SIZE)
        {
            memcpy(rx_queue[queue_head],
                   uart6_rx_buf,
                   Size);

            rx_queue_size[queue_head] = Size;

            queue_head = (uint8_t)((queue_head + 1)
                                   % RX_QUEUE_SIZE);

            queue_count++;
        }
        else
        {
            rx_dropped++;
        }
    }

    /*
     * En mode DMA normal, il faut relancer la reception
     * apres chaque evenement IDLE ou fin de transfert.
     */
    if (UART6_StartReception() != HAL_OK)
    {
        rx_errors++;
    }
}

/* Gestion des erreurs UART */
void HAL_UART_ErrorCallback(UART_HandleTypeDef *huart)
{
    if (huart->Instance == USART6)
    {
        rx_errors++;

        /*
         * Tenter de relancer la reception si le DMA
         * est arrete apres une erreur.
         */
        if (huart->RxState == HAL_UART_STATE_READY)
        {
            if (UART6_StartReception() != HAL_OK)
            {
                rx_errors++;
            }
        }
    }
}

/* Gestion des erreurs fatales */
void Error_Handler(void)
{
    __disable_irq();

    while (1)
    {
        HAL_GPIO_TogglePin(LD2_GPIO_Port, LD2_Pin);

        for (volatile uint32_t i = 0; i < 500000; i++)
        {
            __NOP();
        }
    }
}

#ifdef USE_FULL_ASSERT

void assert_failed(uint8_t *file, uint32_t line)
{
    (void)file;
    (void)line;
}

#endif
